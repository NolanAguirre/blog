#!/bin/sh
# Export each file in an env-dir as an environment variable, then exec a command.
# Usage: scripts/run-with-env-dir <env-dir> <command> [args...]
# If <env-dir>/default exists, load that directory. Otherwise load files in <env-dir>.
# Each regular file becomes VAR=<file contents> where VAR is the file name.
# A single trailing newline is trimmed from each value.

set -e

env_dir=$1
if [ -z "$env_dir" ]; then
    echo "usage: run-with-env-dir <env-dir> <command> [args...]" >&2
    exit 2
fi
shift

if [ ! -d "$env_dir" ]; then
    echo "env-dir not found: $env_dir" >&2
    exit 2
fi

if [ -d "$env_dir/default" ]; then
    env_dir="$env_dir/default"
fi

for f in "$env_dir"/*; do
    [ -f "$f" ] || continue
    name=$(basename "$f")
    value=$(cat "$f")
    export "$name=$value"
done

exec "$@"
